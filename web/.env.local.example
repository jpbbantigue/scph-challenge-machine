# Copy this file to .env.local for local development (`next dev` reads it
# automatically). Never commit the real .env.local — it's already excluded
# in .gitignore.

# Neon Postgres — pooled connection string ("-pooler" endpoint). Either name
# works; the app checks POSTGRES_URL first, then DATABASE_URL.
POSTGRES_URL=
DATABASE_URL=

# HMAC session-signing secret — any long random string. Changing it
# invalidates all existing sessions.
SESSION_SECRET=

# OAuth apps — only the providers you configure will show a "Continue with
# ..." button. Redirect URI to register with each provider:
#   https://<your-domain>/api/auth-callback?provider=<google|discord|facebook>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Discord server (guild) id used to grant the higher "scph" daily AI-credit
# tier (100/day vs. 50/day) to members of the Suno Creatives PH Discord.
# Discord: enable Developer Mode, right-click the server icon, Copy Server ID.
SCPH_GUILD_ID=

# This site's own Groq key, used by /api/generate for the credit-metered
# "Use AI" roll button. Get a free key at https://console.groq.com
GROQ_API_KEY=
